generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  PENDING
  TRIAL
  ACTIVE
  SUSPENDED
  ARCHIVED
  DELETED
}

enum DomainType {
  SUBDOMAIN
  CUSTOM
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  GRADUATED
  TRANSFERRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
  MANUAL
  BANK_TRANSFER
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

model Tenant {
  id                          String                       @id @default(uuid())
  name                        String
  slug                        String                       @unique
  logoUrl                     String?
  faviconUrl                  String?
  primaryColor                String?                      @default("#0f172a")
  secondaryColor              String?                      @default("#3b82f6")
  timezone                    String                       @default("UTC")
  locale                      String                       @default("en")
  currency                    String                       @default("USD")
  status                      TenantStatus                 @default(ACTIVE)
  plan                        String                       @default("standard")
  features                    Json?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  domains                     TenantDomain[]
  campuses                    Campus[]
  users                       User[]
  roles                       Role[]
  students                    Student[]
  parents                     Parent[]
  teachers                    Teacher[]
  academicYears               AcademicYear[]
  terms                       Term[]
  classes                     Class[]
  subjects                    Subject[]
  enrollments                 Enrollment[]
  attendance                  Attendance[]
  examinations                Examination[]
  results                     Result[]
  gradingScales               GradingScale[]
  feeStructures               FeeStructure[]
  feeWaivers                  FeeWaiver[]
  invoices                    Invoice[]
  payments                    Payment[]
  payrolls                    Payroll[]
  expenses                    Expense[]
  vehicles                    Vehicle[]
  transportRoutes             TransportRoute[]
  studentTransportAllocations StudentTransportAllocation[]
  transportTrips              TransportTrip[]
  tripBoardingRecords         TripBoardingRecord[]
  vehicleGpsLogs              VehicleGpsLog[]
  timetables                  Timetable[]
  homework                    Homework[]
  homeworkSubmissions         HomeworkSubmission[]
  studyMaterials              StudyMaterial[]
  syllabusTopics              SyllabusTopic[]
  communicationThreads        CommunicationThread[]
  notifications               Notification[]
  fileAssets                  FileAsset[]
  subscriptions               Subscription[]
  billingInvoices             BillingInvoice[]
  auditLogs                   AuditLog[]
  staffSalaryProfiles         StaffSalaryProfile[]
  assessmentStructures        AssessmentStructure[]
  academicSummaries           AcademicSummary[]
  admissionInquiries          AdmissionInquiry[]
  admissionApplications       AdmissionApplication[]
  admissionOffers             AdmissionOffer[]
  disciplineIncidents         DisciplineIncident[]
  disciplinaryActions         DisciplinaryAction[]
  detentionSessions           DetentionSession[]
  detentionAssignments       DetentionAssignment[]
  meritAwards                 MeritAward[]
  hostels                     Hostel[]
  hostelRooms                 HostelRoom[]
  hostelBeds                  HostelBed[]
  hostelAllocations           HostelAllocation[]
  hostelExeats                HostelExeat[]
  hostelCurfewSessions        HostelCurfewSession[]
  hostelCurfewAttendances     HostelCurfewAttendance[]
  books                       Book[]
  bookCopies                  BookCopy[]
  bookIssues                  BookIssue[]
  bookReservations            BookReservation[]
  libraryFines                LibraryFine[]
  vendors                     Vendor[]
  inventoryItems              InventoryItem[]
  inventoryStockMovements     InventoryStockMovement[]
  schoolAssets                SchoolAsset[]
  assetDepreciationSchedules  AssetDepreciationSchedule[]
  assetMaintenanceLogs        AssetMaintenanceLog[]
  purchaseOrders              PurchaseOrder[]
  purchaseOrderItems          PurchaseOrderItem[]
  impersonationSessions       ImpersonationSession[]
  dataImportJobs              DataImportJob[]
  dataExportJobs              DataExportJob[]

  @@index([slug])
  @@index([status])
}

model TenantDomain {
  id                String     @id @default(uuid())
  tenantId          String
  domain            String     @unique
  type              DomainType @default(SUBDOMAIN)
  isPrimary         Boolean    @default(false)
  isVerified        Boolean    @default(true)
  verificationToken String?
  sslStatus         String?    @default("PENDING")
  sslIssuedAt       DateTime?
  sslExpiresAt      DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([domain])
}

model Campus {
  id                          String                       @id @default(uuid())
  tenantId                    String
  name                        String
  code                        String
  address                     String?
  city                        String?
  state                       String?
  country                     String?
  phone                       String?
  email                       String?
  isMain                      Boolean                      @default(false)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  tenant                      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userCampuses                UserCampus[]
  students                    Student[]
  teachers                    Teacher[]
  classes                     Class[]
  attendance                  Attendance[]
  examinations                Examination[]
  gradingScales               GradingScale[]
  feeStructures               FeeStructure[]
  expenses                    Expense[]
  vehicles                    Vehicle[]
  transportRoutes             TransportRoute[]
  studentTransportAllocations StudentTransportAllocation[]
  transportTrips              TransportTrip[]
  timetables                  Timetable[]
  payrolls                    Payroll[]
  staffSalaryProfiles         StaffSalaryProfile[]
  assessmentStructures        AssessmentStructure[]
  admissionInquiries          AdmissionInquiry[]
  admissionApplications       AdmissionApplication[]
  admissionOffers             AdmissionOffer[]
  homework                    Homework[]
  studyMaterials              StudyMaterial[]
  disciplineIncidents         DisciplineIncident[]
  detentionSessions           DetentionSession[]
  meritAwards                 MeritAward[]
  hostels                     Hostel[]
  hostelRooms                 HostelRoom[]
  hostelBeds                  HostelBed[]
  hostelAllocations           HostelAllocation[]
  hostelExeats                HostelExeat[]
  hostelCurfewSessions        HostelCurfewSession[]
  hostelCurfewAttendances     HostelCurfewAttendance[]
  books                       Book[]
  bookCopies                  BookCopy[]
  bookIssues                  BookIssue[]
  bookReservations            BookReservation[]
  libraryFines                LibraryFine[]
  inventoryItems              InventoryItem[]
  inventoryStockMovements     InventoryStockMovement[]
  schoolAssets                SchoolAsset[]
  purchaseOrders              PurchaseOrder[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model User {
  id              String               @id @default(uuid())
  tenantId        String
  email           String
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  avatarUrl       String?
  isActive        Boolean              @default(true)
  isPlatformAdmin Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  userCampuses    UserCampus[]
  teacherProfile  Teacher?
  mfaSecret       MfaSecret?
  resetTokens     PasswordResetToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, email])
}

model Role {
  id          String           @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  module          String
  createdAt       DateTime         @default(now())

  rolePermissions RolePermission[]

  @@index([module])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
}

model UserCampus {
  id        String  @id @default(uuid())
  userId    String
  campusId  String
  isDefault Boolean @default(false)

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus    Campus  @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@unique([userId, campusId])
  @@index([userId])
  @@index([campusId])
}

model Student {
  id                   String                       @id @default(uuid())
  tenantId             String
  campusId             String
  admissionNumber      String
  firstName            String
  middleName           String?
  lastName             String
  gender               String
  dateOfBirth          DateTime?
  bloodGroup           String?
  email                String?
  phone                String?
  address              String?
  photoUrl             String?
  status               StudentStatus                @default(ACTIVE)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  tenant               Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus               Campus                       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  parents              StudentParent[]
  enrollments          Enrollment[]
  attendance           Attendance[]
  results              Result[]
  feeWaivers           FeeWaiver[]
  invoices             Invoice[]
  payments             Payment[]
  transportAllocations StudentTransportAllocation[]
  tripBoardings        TripBoardingRecord[]
  homeworkSubmissions  HomeworkSubmission[]
  academicSummaries    AcademicSummary[]
  lifecycleEvents      StudentLifecycleEvent[]
  alumniRecord         AlumniRecord?
  disciplineIncidents  DisciplineIncident[]
  disciplinaryActions  DisciplinaryAction[]
  detentionAssignments DetentionAssignment[]
  meritAwards          MeritAward[]
  hostelAllocations    HostelAllocation[]
  hostelExeats         HostelExeat[]
  hostelCurfewAttendances HostelCurfewAttendance[]
  bookIssues           BookIssue[]
  bookReservations     BookReservation[]
  libraryFines         LibraryFine[]

  @@unique([tenantId, admissionNumber])
  @@index([tenantId])
  @@index([tenantId, campusId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model Parent {
  id           String          @id @default(uuid())
  tenantId     String
  firstName    String
  lastName     String
  email        String?
  phone        String
  relationship String          @default("Parent")
  occupation   String?
  address      String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students     StudentParent[]

  @@index([tenantId])
  @@index([tenantId, phone])
}

model StudentParent {
  id               String  @id @default(uuid())
  studentId        String
  parentId         String
  isPrimaryContact Boolean @default(true)

  student          Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent           Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@index([studentId])
  @@index([parentId])
}

model Teacher {
  id               String           @id @default(uuid())
  tenantId         String
  campusId         String
  userId           String?          @unique
  employeeNumber   String
  firstName        String
  lastName         String
  email            String
  phone            String?
  specialization   String?
  qualification    String?
  joiningDate      DateTime?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus           Campus           @relation(fields: [campusId], references: [id], onDelete: Cascade)
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  classes          Class[]
  classSubjects    ClassSubject[]
  timetableEntries TimetableEntry[]

  @@unique([tenantId, employeeNumber])
  @@index([tenantId])
  @@index([tenantId, campusId])
}

model AcademicYear {
  id                          String                       @id @default(uuid())
  tenantId                    String
  name                        String
  startDate                   DateTime
  endDate                     DateTime
  isCurrent                   Boolean                      @default(false)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  tenant                      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terms                       Term[]
  classes                     Class[]
  enrollments                 Enrollment[]
  examinations                Examination[]
  feeStructures               FeeStructure[]
  studentTransportAllocations StudentTransportAllocation[]
  timetables                  Timetable[]
  admissionInquiries          AdmissionInquiry[]
  admissionApplications       AdmissionApplication[]
  admissionOffers             AdmissionOffer[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Term {
  id             String         @id @default(uuid())
  tenantId       String
  academicYearId String
  name           String
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  examinations   Examination[]
  feeStructures  FeeStructure[]
  timetables     Timetable[]

  @@unique([academicYearId, name])
  @@index([tenantId])
}

model Class {
  id             String         @id @default(uuid())
  tenantId       String
  campusId       String
  academicYearId String
  name           String
  gradeLevel     String
  stream         String?
  capacity       Int            @default(40)
  classTeacherId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus         Campus         @relation(fields: [campusId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classTeacher   Teacher?       @relation(fields: [classTeacherId], references: [id], onDelete: SetNull)
  classSubjects  ClassSubject[]
  enrollments    Enrollment[]
  attendance     Attendance[]
  examSchedules  ExamSchedule[]
  timetables     Timetable[]
  homework       Homework[]
  studyMaterials StudyMaterial[]
  syllabusTopics SyllabusTopic[]
  disciplineIncidents DisciplineIncident[]
  meritAwards    MeritAward[]
  academicSummaries AcademicSummary[]

  @@unique([tenantId, campusId, academicYearId, name])
  @@index([tenantId])
  @@index([tenantId, campusId])
}

model Subject {
  id               String           @id @default(uuid())
  tenantId         String
  code             String
  name             String
  description      String?
  isElective       Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classSubjects    ClassSubject[]
  examSchedules    ExamSchedule[]
  results          Result[]
  timetableEntries TimetableEntry[]
  homework         Homework[]
  studyMaterials   StudyMaterial[]
  syllabusTopics   SyllabusTopic[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model ClassSubject {
  id        String   @id @default(uuid())
  classId   String
  subjectId String
  teacherId String?

  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
}

model Enrollment {
  id             String       @id @default(uuid())
  tenantId       String
  studentId      String
  classId        String
  academicYearId String
  rollNumber     String?
  status         String       @default("ACTIVE")
  enrolledAt     DateTime     @default(now())

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, academicYearId])
  @@index([tenantId])
  @@index([tenantId, classId])
  @@index([studentId])
}

model Attendance {
  id             String           @id @default(uuid())
  tenantId       String
  campusId       String
  studentId      String
  classId        String
  subjectId      String?
  sessionId      String?
  sessionType    String           @default("DAILY") // DAILY, MORNING, AFTERNOON, SUBJECT_PERIOD, ASSEMBLY, EXAMINATION, CUSTOM
  date           DateTime
  status         AttendanceStatus @default(PRESENT)
  method         String           @default("MANUAL") // MANUAL, QR, RFID, BIOMETRIC, EXTERNAL_DEVICE
  checkInTime    DateTime?
  checkOutTime   DateTime?
  remarks        String?
  markedByUserId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus         Campus           @relation(fields: [campusId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class          Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject        Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  session        AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, studentId, classId, subjectId, sessionId, date])
  @@index([tenantId])
  @@index([tenantId, campusId])
  @@index([tenantId, classId, date])
  @@index([tenantId, studentId, date])
  @@index([tenantId, subjectId])
}

model Examination {
  id             String         @id @default(uuid())
  tenantId       String
  campusId       String
  academicYearId String
  termId         String
  name           String
  examType       String         @default("TERM_EXAM")
  startDate      DateTime
  endDate        DateTime
  isPublished    Boolean        @default(false)
  createdAt      DateTime       @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus         Campus         @relation(fields: [campusId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term           Term           @relation(fields: [termId], references: [id], onDelete: Cascade)
  schedules      ExamSchedule[]
  results        Result[]

  @@index([tenantId])
  @@index([tenantId, campusId])
}

model ExamSchedule {
  id            String      @id @default(uuid())
  examinationId String
  classId       String
  subjectId     String
  examDate      DateTime
  startTime     String
  endTime       String
  maxMarks      Float       @default(100)
  passMarks     Float       @default(40)

  examination   Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  class         Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([examinationId, classId, subjectId])
  @@index([examinationId])
}

model Result {
  id                    String               @id @default(uuid())
  tenantId              String
  examinationId         String
  studentId             String
  subjectId             String
  assessmentStructureId String?
  classId               String?
  marksObtained         Float
  maxMarks              Float                @default(100)
  grade                 String?
  gradePoint            Float?
  remarks               String?
  componentScores       Json?
  isApproved            Boolean              @default(false)
  approvedAt            DateTime?
  approvedByUserId      String?
  isPublished           Boolean              @default(false)
  publishedAt           DateTime?
  enteredByUserId       String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  examination           Examination          @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  student               Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject               Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  assessmentStructure   AssessmentStructure? @relation(fields: [assessmentStructureId], references: [id], onDelete: SetNull)

  @@unique([tenantId, examinationId, studentId, subjectId])
  @@index([tenantId])
  @@index([tenantId, examinationId])
  @@index([tenantId, studentId])
  @@index([tenantId, assessmentStructureId])
}

model AssessmentStructure {
  id          String   @id @default(uuid())
  tenantId    String
  campusId    String?
  name        String
  code        String?
  description String?
  components  Json
  totalWeight Float    @default(100)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus      Campus?  @relation(fields: [campusId], references: [id], onDelete: SetNull)
  results     Result[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, campusId])
}

model AcademicSummary {
  id                     String    @id @default(uuid())
  tenantId               String
  studentId              String
  academicYearId         String?
  termId                 String?
  examinationId          String?
  classId                String
  totalSubjects          Int
  totalMarks             Float
  maxMarks               Float
  percentage             Float
  gpa                    Float     @default(0)
  cgpa                   Float?    @default(0)
  classRank              Int?
  totalStudentsInClass   Int?
  classAveragePercentage Float?
  academicStanding       String    @default("GOOD_STANDING")
  subjectSummaries       Json?
  status                 String    @default("CALCULATED") // CALCULATED, PUBLISHED, ARCHIVED
  calculatedAt           DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student                Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class                  Class     @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, classId, examinationId])
  @@index([tenantId])
  @@index([tenantId, classId])
  @@index([tenantId, studentId])
  @@index([tenantId, examinationId])
}

model GradingScale {
  id          String   @id @default(uuid())
  tenantId    String
  campusId    String?
  name        String
  minScore    Float
  maxScore    Float
  grade       String
  gradePoint  Float    @default(0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus      Campus?  @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@unique([tenantId, name, grade])
  @@index([tenantId])
  @@index([tenantId, campusId])
}

model FeeStructure {
  id                          String       @id @default(uuid())
  tenantId                    String
  campusId                    String
  academicYearId              String
  termId                      String?
  name                        String
  code                        String?
  description                 String?
  classId                     String?
  amount                      Float
  currency                    String       @default("USD")
  items                       Json?
  targetAudience              String       @default("ALL") // ALL, NEW_STUDENTS, RETURNING_STUDENTS, DAY_STUDENTS, BOARDING_STUDENTS
  lateFeePercentage           Float?       @default(0)
  lateFeeGraceDays            Int?         @default(0)
  earlyBirdDiscountPercentage Float?       @default(0)
  earlyBirdCutoffDate         DateTime?
  status                      String       @default("ACTIVE")
  dueDate                     DateTime?
  applicableGradeLevel        String?
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @default(now()) @updatedAt

