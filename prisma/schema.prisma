  hostel               Hostel      @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  room                 HostelRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  student              Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, campusId])
  @@index([tenantId, hostelId])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
  @@index([tenantId, expectedReturnDate])
}

model HostelCurfewSession {
  id                String                   @id @default(uuid())
  tenantId          String
  campusId          String
  hostelId          String
  sessionDate       DateTime
  sessionType       String                   @default("NIGHT_CURFEW") // EVENING_ROLL_CALL, NIGHT_CURFEW, MORNING_HEADCOUNT, WEEKEND_CHECK
  conductedByUserId String
  status            String                   @default("COMPLETED") // IN_PROGRESS, COMPLETED
  totalExpected     Int                      @default(0)
  totalPresent      Int                      @default(0)
  totalAbsent       Int                      @default(0)
  totalOnExeat      Int                      @default(0)
  notes             String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus            Campus                   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  hostel            Hostel                   @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  attendances       HostelCurfewAttendance[]

  @@index([tenantId])
  @@index([tenantId, campusId])
  @@index([tenantId, hostelId])
  @@index([tenantId, sessionDate])
}

model HostelCurfewAttendance {
  id             String              @id @default(uuid())
  tenantId       String
  campusId       String
  sessionId      String
  hostelId       String
  studentId      String
  roomId         String?
  bedId          String?
  status         String              // PRESENT, ABSENT_UNEXCUSED, EXEAT_ON_LEAVE, IN_CLINIC, LATE
  remarks        String?
  markedByUserId String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus         Campus              @relation(fields: [campusId], references: [id], onDelete: Cascade)
  session        HostelCurfewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  hostel         Hostel              @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  student        Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([tenantId])
  @@index([tenantId, sessionId])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
}

model Book {
  id              String            @id @default(uuid())
  tenantId        String
  campusId        String
  title           String
  isbn            String?
  isbn13          String?
  author          String
  coAuthors       String?
  publisher       String?
  publicationYear Int?
  edition         String?
  category        String            @default("GENERAL_KNOWLEDGE") // MATHEMATICS, SCIENCES, LANGUAGES, LITERATURE, HUMANITIES, TECHNOLOGY, ARTS, GENERAL_KNOWLEDGE, OTHER
  deweyDecimal    String?           // e.g. "510", "823"
  shelfLocation   String?           // e.g. "Aisle 3 - Bay B"
  description     String?
  coverImageUrl   String?
  totalCopies     Int               @default(1)
  availableCopies Int               @default(1)
  reservedCopies  Int               @default(0)
  status          String            @default("IN_STOCK") // IN_STOCK, LOW_STOCK, OUT_OF_STOCK, ARCHIVED
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus          Campus            @relation(fields: [campusId], references: [id], onDelete: Cascade)
  copies          BookCopy[]
  issues          BookIssue[]
  reservations    BookReservation[]

  @@index([tenantId])
  @@index([tenantId, campusId])
  @@index([tenantId, category])
  @@index([tenantId, isbn])
  @@index([tenantId, deweyDecimal])
  @@index([tenantId, status])
}

model BookCopy {
  id              String      @id @default(uuid())
  tenantId        String
  campusId        String
  bookId          String
  accessionNumber String      // e.g. "ACC-2026-001"
  barcode         String?
  rfidTag         String?
  condition       String      @default("GOOD") // NEW, GOOD, FAIR, POOR, DAMAGED
  status          String      @default("AVAILABLE") // AVAILABLE, ISSUED, RESERVED, MAINTENANCE, LOST, WEEDED
  purchasePrice   Float?
  acquisitionDate DateTime    @default(now())
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus          Campus      @relation(fields: [campusId], references: [id], onDelete: Cascade)
  book            Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  issues          BookIssue[]

  @@unique([tenantId, accessionNumber])
  @@index([tenantId])
  @@index([tenantId, campusId])
  @@index([tenantId, bookId])
  @@index([tenantId, barcode])
  @@index([tenantId, rfidTag])
  @@index([tenantId, status])
}

model BookIssue {
  id               String        @id @default(uuid())
  tenantId         String
  campusId         String
  bookId           String
  bookCopyId       String?
  borrowerType     String        @default("STUDENT") // STUDENT, STAFF, TEACHER
  studentId        String?
  staffUserId      String?
  issuedByUserId   String
  issueDate        DateTime      @default(now())
  dueDate          DateTime
  returnDate       DateTime?
  status           String        @default("ACTIVE") // ACTIVE, RETURNED, OVERDUE, LOST_CLAIMED
  renewalsCount    Int           @default(0)
  maxRenewals      Int           @default(2)
  returnCondition  String?
  returnNotes      String?
  receivedByUserId String?
  overdueDays      Int           @default(0)
  fineAmount       Float         @default(0)
  finePaidStatus   String        @default("NONE") // NONE, PENDING, PAID, WAIVED
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus           Campus        @relation(fields: [campusId], references: [id], onDelete: Cascade)
  book             Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookCopy         BookCopy?     @relation(fields: [bookCopyId], references: [id], onDelete: SetNull)
  student          Student?      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fines            LibraryFine[]

  @@index([tenantId])
  @@index([tenantId, campusId])
  @@index([tenantId, bookId])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
}

model BookReservation {
  id              String    @id @default(uuid())
  tenantId        String
  campusId        String
  bookId          String
  borrowerType    String    @default("STUDENT") // STUDENT, STAFF
  studentId       String?
  staffUserId     String?
  reservationDate DateTime  @default(now())
  expiryDate      DateTime?
  status          String    @default("ACTIVE_WAITING") // ACTIVE_WAITING, READY_FOR_PICKUP, FULFILLED, CANCELLED, EXPIRED
  priorityQueue   Int       @default(1)
  notifiedAt      DateTime?
  fulfilledAt     DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus          Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  book            Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student         Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, campusId])
  @@index([tenantId, bookId])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
}

model LibraryFine {
  id               String     @id @default(uuid())
  tenantId         String
  campusId         String
  issueId          String
  studentId        String?
  staffUserId      String?
  overdueDays      Int        @default(0)
  ratePerDay       Float      @default(100.0)
  totalAmount      Float      @default(0)
  paidAmount       Float      @default(0)
  balanceDue       Float      @default(0)
  status           String     @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID, WAIVED
  waivedByUserId   String?
  waiveReason      String?
  paymentReference String?
  paidAt           DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus           Campus     @relation(fields: [campusId], references: [id], onDelete: Cascade)
  issue            BookIssue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  student          Student?   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, campusId])
  @@index([tenantId, issueId])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
}

model Vendor {
  id             String          @id @default(uuid())
  tenantId       String
  name           String
  code           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  taxId          String?
  category       String          @default("GENERAL") // GENERAL, EQUIPMENT, UNIFORMS, TEXTBOOKS, LAB_SUPPLIES, STATIONERY, MAINTENANCE
  paymentTerms   String          @default("NET_30") // IMMEDIATE, NET_15, NET_30, NET_60
  status         String          @default("ACTIVE") // ACTIVE, INACTIVE, BLACKLISTED
  rating         Float           @default(5.0)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  assets         SchoolAsset[]
  maintenance    AssetMaintenanceLog[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, category])
}

model InventoryItem {
  id               String                   @id @default(uuid())
  tenantId         String
  campusId         String?
  name             String
  sku              String
  category         String                   @default("ACADEMIC") // ACADEMIC, UNIFORMS, TEXTBOOKS, LAB_EQUIPMENT, STATIONERY, CLEANING_SUPPLIES, FIRST_AID, SPORTS, MAINTENANCE
  description      String?
  unitOfMeasure    String                   @default("PIECES") // PIECES, BOXES, SETS, KG, LITERS, PACKS, PAIRS
  unitCost         Float                    @default(0.0)
  unitSellingPrice Float?
  quantityOnHand   Int                      @default(0)
  reorderThreshold Int                      @default(10)
  reorderQuantity  Int                      @default(50)
  storageLocation  String?
  status           String                   @default("ACTIVE") // ACTIVE, DISCONTINUED, OUT_OF_STOCK
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus           Campus?                  @relation(fields: [campusId], references: [id], onDelete: SetNull)
  movements        InventoryStockMovement[]
  poItems          PurchaseOrderItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, campusId])
  @@index([tenantId, category])
  @@index([tenantId, status])
}

model InventoryStockMovement {
  id              String        @id @default(uuid())
  tenantId        String
  campusId        String?
  inventoryItemId String
  type            String        // RECEIPT_PURCHASE, STOCK_IN, STOCK_OUT_ISSUED, CONSUMPTION, DAMAGE_LOSS, RETURN_TO_VENDOR, AUDIT_ADJUSTMENT
  quantity        Int
  previousQty     Int
  newQty          Int
  unitCost        Float?
  referenceNumber String?
  issuedToType    String?       // STUDENT, STAFF, DEPARTMENT, CLASSROOM, LAB
  issuedToId      String?
  performedBy     String
  notes           String?
  createdAt       DateTime      @default(now())

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus          Campus?       @relation(fields: [campusId], references: [id], onDelete: SetNull)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, campusId])
  @@index([tenantId, inventoryItemId])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
}

model SchoolAsset {
  id                      String                      @id @default(uuid())
  tenantId                String
  campusId                String?
  name                    String
  assetTag                String
  category                String                      @default("FURNITURE") // LAB_EQUIPMENT, ICT_HARDWARE, FURNITURE, VEHICLES, SPORTS_FACILITIES, BUILDING_INFRASTRUCTURE, KITCHEN_CAFETERIA
  serialNumber            String?
  model                   String?
  manufacturer            String?
  purchaseDate            DateTime                    @default(now())
  purchaseCost            Float                       @default(0.0)
  vendorId                String?
  warrantyExpiry          DateTime?
  usefulLifeYears         Int                         @default(5)
  salvageValue            Float                       @default(0.0)
  depreciationMethod      String                      @default("STRAIGHT_LINE") // STRAIGHT_LINE, REDUCING_BALANCE, NONE
  currentBookValue        Float                       @default(0.0)
  accumulatedDepreciation Float                       @default(0.0)
  lastDepreciationDate    DateTime?
  location                String?
  assignedToStaffId       String?
  condition               String                      @default("GOOD") // EXCELLENT, GOOD, FAIR, NEEDS_REPAIR, DAMAGED, DISPOSED
  status                  String                      @default("IN_SERVICE") // IN_SERVICE, UNDER_MAINTENANCE, RESERVED, DECOMMISSIONED, WRITTEN_OFF
  notes                   String?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  tenant                  Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus                  Campus?                     @relation(fields: [campusId], references: [id], onDelete: SetNull)
  vendor                  Vendor?                     @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  depreciationSchedules   AssetDepreciationSchedule[]
  maintenanceLogs         AssetMaintenanceLog[]

  @@unique([tenantId, assetTag])
  @@index([tenantId])
  @@index([tenantId, campusId])
  @@index([tenantId, category])
  @@index([tenantId, status])
}

model AssetDepreciationSchedule {
  id                 String      @id @default(uuid())
  tenantId           String
  assetId            String
  financialYear      String
  period             String      // FY2026-Q1, 2026-ANNUAL, etc.
  depreciationAmount Float
  beginningBookValue Float
  endingBookValue    Float
  calculatedAt       DateTime    @default(now())
  calculatedBy       String
  notes              String?

  tenant             Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset              SchoolAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, assetId])
  @@index([tenantId, financialYear])
}

model AssetMaintenanceLog {
  id                  String       @id @default(uuid())
  tenantId            String
  assetId             String
  maintenanceType     String       @default("ROUTINE_SERVICE") // ROUTINE_SERVICE, REPAIR, CALIBRATION, SAFETY_INSPECTION, EMERGENCY_FIX
  serviceDate         DateTime     @default(now())
  performedByVendorId String?
  technicianName      String?
  cost                Float        @default(0.0)
  description         String
  findings            String?
  nextServiceDue      DateTime?
  status              String       @default("COMPLETED") // SCHEDULED, COMPLETED, CANCELLED
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  tenant              Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset               SchoolAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  vendor              Vendor?      @relation(fields: [performedByVendorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, assetId])
  @@index([tenantId, status])
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  tenantId             String
  campusId             String?
  orderNumber          String
  vendorId             String
  orderDate            DateTime            @default(now())
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  totalAmount          Float               @default(0.0)
  currency             String              @default("USD")
  status               String              @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, ORDERED, PARTIALLY_DELIVERED, RECEIVED, CANCELLED
  approvedBy           String?
  approvedAt           DateTime?
  deliveryNotes        String?
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus               Campus?             @relation(fields: [campusId], references: [id], onDelete: SetNull)
  vendor               Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items                PurchaseOrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, campusId])
  @@index([tenantId, vendorId])
  @@index([tenantId, status])
}

model PurchaseOrderItem {
  id               String         @id @default(uuid())
  tenantId         String
  purchaseOrderId  String
  inventoryItemId  String?
  itemName         String
  description      String?
  quantityOrdered  Int
  quantityReceived Int            @default(0)
  unitPrice        Float          @default(0.0)
  totalPrice       Float          @default(0.0)
  status           String         @default("PENDING") // PENDING, PARTIALLY_DELIVERED, RECEIVED, CANCELLED

  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder    PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem    InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, purchaseOrderId])
  @@index([tenantId, inventoryItemId])
}

model ImpersonationSession {
  id               String    @id @default(uuid())
  tenantId         String
  superAdminUserId String
  targetUserId     String
  reason           String
  token            String?
  startedAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revocationReason String?
  isActive         Boolean   @default(true)
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())

  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([superAdminUserId])
  @@index([targetUserId])
  @@index([isActive])
}

model DataImportJob {
  id                String    @id @default(uuid())
  tenantId          String
  campusId          String?
  type              String    // STUDENTS, PARENTS, STAFF, GRADES
  fileName          String
  totalRows         Int       @default(0)
  processedRows     Int       @default(0)
  successfulRows    Int       @default(0)
  failedRows        Int       @default(0)
  errors            Json?
  status            String    @default("COMPLETED") // VALIDATED, COMPLETED, FAILED
  performedByUserId String
  createdAt         DateTime  @default(now())

  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([type])
  @@index([status])
}

model DataExportJob {
  id                String    @id @default(uuid())
  tenantId          String
  format            String    @default("JSON") // JSON, CSV, EXCEL, ZIP
  entities          Json?     // array of entity names included
  status            String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  fileUrl           String?
  fileSizeBytes     Int?      @default(0)
  expiresAt         DateTime?
  error             String?
  requestedByUserId String
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
}
